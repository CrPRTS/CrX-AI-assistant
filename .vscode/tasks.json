{
    // 纯 VS Code 离线编译：arduino-cli + F:\Git\Arduino15 离线工具链
    // Ctrl+Shift+B = 编译 AI_KEY_v3；终端里 "Run Task" 可选其他任务
    "version": "2.0.0",
    "options": {
        "env": {
            "ARDUINO_CLI": "E:\\ExtraAppsHDD\\arduino-cli.exe",
            "ARDUINO_CFG": "${workspaceFolder}\\arduino-cli.yaml",
            "ARDUINO_FQBN": "esp32:esp32:esp32s3:FlashSize=16M",
            "BUILD_ROOT": "${workspaceFolder}\\build"
        }
    },
    "tasks": [
        {
            "label": "编译 AI_KEY_v3",
            "type": "shell",
            // 编译后刷新 IntelliSense 配置：includePath/defines 来自本次真实编译参数
            // 不要加 --output-dir / -e：esp32 core 的 savehex 钩子会往 sketch 目录里
            // 再写一份 AI_KEY_v3\build\esp32.esp32.esp32s3\，产物就散成两处了。
            // 最终产物本来就在 --build-path 里，upload 用 --build-path 即可。
            "command": "& $env:ARDUINO_CLI --config-file $env:ARDUINO_CFG compile --fqbn $env:ARDUINO_FQBN --build-path \"$env:BUILD_ROOT\\AI_KEY_v3\" '${workspaceFolder}\\AI_KEY_v3'; if ($?) { & powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\.vscode\\gen-intellisense.ps1\" }",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}\\build\\AI_KEY_v3"
                ],
                "pattern": [
                    {
                        "regexp": "^(.*?):(\\d+):(\\d+):\\s+(fatal error|error|warning|note):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                ]
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            // 与默认「编译 AI_KEY_v3」完全一致，仅多两个 --build-property：
            //   build.extra_flags=-DESP32=ESP32 -g0 → 末尾 -g0 覆盖 core 的 -gdwarf-4/-ggdb。
            //     build.extra_flags 是整体替换：esp32 core 3.3.11 把 -DESP32/-DCORE_DEBUG_LEVEL/
            //     -DARDUINO_USB_* 等塞在这个属性里（platform.txt:105）。本 sketch/库只用到
            //     -DESP32（PN532 的 #if defined(ESP32) 1MHz 守卫依赖它），其余 7 个本代码未用，
            //     两个带引号的 ARDUINO_HOST_OS/ARDUINO_FQBN 直接省略（避免 PowerShell 内嵌引号坑）。
            //     值对应当前 FQBN esp32s3 + 3.3.11 默认展开；换 FQBN / 核心版本后需重跑一次校对。
            //   compiler.c.elf.extra_flags=-Wl,-s  → 链接时 strip 符号表（.elf 更小），空属性纯追加。
            // 烧录用 .bin 不受影响；需要 GDB/JTAG 调试时改回默认任务编译即可。
            "label": "编译 AI_KEY_v3（无调试）",
            "type": "shell",
            "command": "& $env:ARDUINO_CLI --config-file $env:ARDUINO_CFG compile --fqbn $env:ARDUINO_FQBN --build-path \"$env:BUILD_ROOT\\AI_KEY_v3\" --build-property \"build.extra_flags=-DESP32=ESP32 -g0\" --build-property \"compiler.c.elf.extra_flags=-Wl,-s\" '${workspaceFolder}\\AI_KEY_v3'; if ($?) { & powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\.vscode\\gen-intellisense.ps1\" }",
            "group": "build",
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}\\build\\AI_KEY_v3"
                ],
                "pattern": [
                    {
                        "regexp": "^(.*?):(\\d+):(\\d+):\\s+(fatal error|error|warning|note):\\s+(.*)$",
                        "file": 1,
                        "line": 2,
                        "column": 3,
                        "severity": 4,
                        "message": 5
                    }
                ]
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        },
        {
            // 编译「当前打开的 .ino 所在的 sketch 文件夹」，可加 --clean 强制全量重编
            "label": "编译当前 sketch",
            "type": "shell",
            "command": "$d = Split-Path -Parent $env:ACTIVE_SKETCH; $n = Split-Path -Leaf $d; & $env:ARDUINO_CLI --config-file $env:ARDUINO_CFG compile --fqbn $env:ARDUINO_FQBN --build-path \"$env:BUILD_ROOT\\$n\" \"$d\"",
            "options": {
                "env": {
                    "ACTIVE_SKETCH": "${file}",
                    "BUILD_ROOT": "${workspaceFolder}\\build"
                }
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            // 只刷新 IntelliSense 配置（不重新编译）。改了 FQBN / 换库 / 升级工具链后，
            // 先编译一次，再跑这个任务；随后执行命令面板里的 "C/C++: Reset IntelliSense Database"。
            "label": "刷新 IntelliSense 配置",
            "type": "shell",
            "command": "& powershell -NoProfile -ExecutionPolicy Bypass -File \"${workspaceFolder}\\.vscode\\gen-intellisense.ps1\"",
            "problemMatcher": []
        },
        {
            "label": "清理编译缓存",
            "type": "shell",
            "command": "Remove-Item -Recurse -Force \"$env:BUILD_ROOT\" -ErrorAction SilentlyContinue; Write-Host \"已清理 $env:BUILD_ROOT\"",
            "problemMatcher": []
        },
        {
            "label": "上传到开发板",
            "type": "shell",
            "command": "& $env:ARDUINO_CLI --config-file $env:ARDUINO_CFG upload --fqbn $env:ARDUINO_FQBN --build-path \"$env:BUILD_ROOT\\AI_KEY_v3\" (Read-Host '串口号 (如 COM5)')",
            "problemMatcher": []
        },
        {
            "label": "串口监视器",
            "type": "shell",
            "command": "& $env:ARDUINO_CLI --config-file $env:ARDUINO_CFG monitor --port (Read-Host '串口号') --baud 115200",
            "presentation": {
                "reveal": "always"
            },
            "problemMatcher": []
        },
        {
            "label": "列出可用开发板",
            "type": "shell",
            "command": "& $env:ARDUINO_CLI --config-file $env:ARDUINO_CFG board listall | Select-String esp32",
            "problemMatcher": []
        }
    ]
}